      {
        "name": "_Measures",
        "columns": [
          {
            "name": "RowId",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "RowId"
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #table(type table [RowId = Int64.Type], {{1}})",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Gross Sales",
            "expression": "SUM(vw_sales_fact[ExtendedAmount])",
            "formatString": "\\$#,##0.00",
            "displayFolder": "01. Core Sales & Volume"
          },
          {
            "name": "Discount Amount",
            "expression": "SUM(vw_sales_fact[DiscountAmount])",
            "formatString": "\\$#,##0.00",
            "displayFolder": "01. Core Sales & Volume"
          },
          {
            "name": "Net Sales",
            "expression": "SUM(vw_sales_fact[SalesAmount])",
            "formatString": "\\$#,##0.00",
            "displayFolder": "01. Core Sales & Volume"
          },
          {
            "name": "Units Sold",
            "expression": "SUM(vw_sales_fact[OrderQuantity])",
            "formatString": "#,##0",
            "displayFolder": "01. Core Sales & Volume"
          },
          {
            "name": "Total Orders",
            "expression": "DISTINCTCOUNT(vw_sales_fact[SalesOrderNumber])",
            "formatString": "#,##0",
            "displayFolder": "01. Core Sales & Volume"
          },
          {
            "name": "Order Lines",
            "expression": "COUNTROWS(vw_sales_fact)",
            "formatString": "#,##0",
            "displayFolder": "01. Core Sales & Volume"
          },
          {
            "name": "Average Order Value (AOV)",
            "expression": "DIVIDE([Net Sales], [Total Orders], 0)",
            "formatString": "\\$#,##0.00",
            "displayFolder": "01. Core Sales & Volume"
          },
          {
            "name": "Discount Rate %",
            "expression": "DIVIDE([Discount Amount], [Gross Sales], 0)",
            "formatString": "0.00%",
            "displayFolder": "01. Core Sales & Volume"
          },
          {
            "name": "Total Product Cost",
            "expression": "SUM(vw_sales_fact[TotalProductCost])",
            "formatString": "\\$#,##0.00",
            "displayFolder": "02. Cost & Profitability (Standard Cost)"
          },
          {
            "name": "Gross Profit",
            "expression": "[Net Sales] - [Total Product Cost]",
            "formatString": "\\$#,##0.00",
            "displayFolder": "02. Cost & Profitability (Standard Cost)"
          },
          {
            "name": "Gross Margin %",
            "expression": "DIVIDE([Gross Profit], [Net Sales], 0)",
            "formatString": "0.00%",
            "displayFolder": "02. Cost & Profitability (Standard Cost)"
          },
          {
            "name": "Retail Net Sales",
            "expression": "CALCULATE([Net Sales], KEEPFILTERS(vw_sales_fact[Channel] = \"Internet\"))",
            "formatString": "\\$#,##0.00",
            "displayFolder": "03. Channel Intelligence"
          },
          {
            "name": "Wholesale Net Sales",
            "expression": "CALCULATE([Net Sales], KEEPFILTERS(vw_sales_fact[Channel] = \"Reseller\"))",
            "formatString": "\\$#,##0.00",
            "displayFolder": "03. Channel Intelligence"
          },
          {
            "name": "Retail Gross Profit",
            "expression": "CALCULATE([Gross Profit], KEEPFILTERS(vw_sales_fact[Channel] = \"Internet\"))",
            "formatString": "\\$#,##0.00",
            "displayFolder": "03. Channel Intelligence"
          },
          {
            "name": "Wholesale Gross Profit",
            "expression": "CALCULATE([Gross Profit], KEEPFILTERS(vw_sales_fact[Channel] = \"Reseller\"))",
            "formatString": "\\$#,##0.00",
            "displayFolder": "03. Channel Intelligence"
          },
          {
            "name": "Retail Gross Margin %",
            "expression": "DIVIDE([Retail Gross Profit], [Retail Net Sales], 0)",
            "formatString": "0.00%",
            "displayFolder": "03. Channel Intelligence"
          },
          {
            "name": "Wholesale Gross Margin %",
            "expression": "DIVIDE([Wholesale Gross Profit], [Wholesale Net Sales], 0)",
            "formatString": "0.00%",
            "displayFolder": "03. Channel Intelligence"
          },
          {
            "name": "Net Sales Prior Year",
            "expression": "CALCULATE([Net Sales], SAMEPERIODLASTYEAR(vw_dim_date[Date]))",
            "formatString": "\\$#,##0.00",
            "displayFolder": "04. Time Intelligence & Variance"
          },
          {
            "name": "Net Sales YoY Growth $",
            "expression": "VAR CurrentSales = [Net Sales]\nVAR PreviousSales = [Net Sales Prior Year]\nRETURN IF(NOT ISBLANK(PreviousSales), CurrentSales - PreviousSales, BLANK())",
            "formatString": "\\$#,##0.00",
            "displayFolder": "04. Time Intelligence & Variance"
          },
          {
            "name": "Net Sales YoY Growth %",
            "expression": "DIVIDE([Net Sales YoY Growth $], [Net Sales Prior Year], BLANK())",
            "formatString": "0.0%",
            "displayFolder": "04. Time Intelligence & Variance"
          },
          {
            "name": "Net Sales YTD",
            "expression": "TOTALYTD([Net Sales], vw_dim_date[Date])",
            "formatString": "\\$#,##0.00",
            "displayFolder": "04. Time Intelligence & Variance"
          },
          {
            "name": "% of Total Sales",
            "expression": "DIVIDE([Net Sales], CALCULATE([Net Sales], ALLSELECTED(vw_sales_fact)), 0)",
            "formatString": "0.0%",
            "displayFolder": "05. Contribution & Dynamic Rankings"
          },
          {
            "name": "Product Revenue Rank",
            "expression": "IF(NOT ISBLANK([Net Sales]), RANKX(ALLSELECTED(vw_dim_product[ProductName]), [Net Sales], , DESC, Dense))",
            "formatString": "0",
            "displayFolder": "05. Contribution & Dynamic Rankings"
          },
          {
            "name": "Current Stock Balance",
            "expression": "SUM(vw_inventory_latest[UnitsBalance])",
            "formatString": "#,##0",
            "displayFolder": "06. Inventory & Operational Health"
          },
          {
            "name": "Safety Stock Threshold",
            "expression": "SUM(vw_inventory_latest[SafetyStockLevel])",
            "formatString": "#,##0",
            "displayFolder": "06. Inventory & Operational Health"
          },
          {
            "name": "Critical Stock Shortage Items",
            "expression": "CALCULATE(COUNTROWS(vw_inventory_latest), vw_inventory_latest[StockStatus] = \"Critical Shortage\")",
            "formatString": "#,##0",
            "displayFolder": "06. Inventory & Operational Health"
          },
          {
            "name": "Reorder Alert Items",
            "expression": "CALCULATE(COUNTROWS(vw_inventory_latest), vw_inventory_latest[StockStatus] IN {\"Critical Shortage\", \"Reorder Needed\"})",
            "formatString": "#,##0",
            "displayFolder": "06. Inventory & Operational Health"
          },
          {
            "name": "Total Stock Deficit Units",
            "expression": "SUM(vw_inventory_latest[StockDeficit])",
            "formatString": "#,##0",
            "displayFolder": "06. Inventory & Operational Health"
          }
        ]
      }
    ],
